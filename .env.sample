# ── Telegram credentials ──────────────────────────────────────────────
# Get API_ID / API_HASH from https://my.telegram.org -> API Development Tools
API_ID=
API_HASH=
# Get BOT_TOKEN from @BotFather
BOT_TOKEN=

# ── Ownership ──────────────────────────────────────────────────────────
# Your numeric Telegram user ID (get it from @userinfobot). Full control.
OWNER_ID=
# Optional: comma-separated extra user IDs with sudo/owner-level access
SUDO_USERS=

# ── Database ───────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGO_URI=
DB_NAME=Reze

# ── Support links (shown in /help footer & /start) ───────────────────
SUPPORT_GROUP=https://t.me/your_support_group
SUPPORT_CHANNEL=https://t.me/your_support_channel

# ── Optional: logs every new chat the bot joins/leaves to this chat ──
LOG_GROUP_ID=

# ── Optional modules (bot runs fine without these; the module just
#    replies honestly that it isn't configured yet) ────────────────────
# imdb.py -- free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# ai.py + chat.py -- your xAI (Grok) API key, https://console.x.ai
# Powers both the /ai command and Reze's passive chat mode (replies
# when @mentioned or when someone says "reze" in a message).
XAI_API_KEY=
XAI_MODEL=grok-4.5
